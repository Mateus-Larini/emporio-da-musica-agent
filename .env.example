# Provedor do modelo: "groq" ou "google" (gratuitos, sem cartão) ou "anthropic" (Claude).
# Se omitido, usa o provedor cuja chave estiver presente.
EMPORIO_PROVIDER=groq

# Groq: chave gratuita em https://console.groq.com/keys
GROQ_API_KEY=gsk_...

# Google Gemini: chave gratuita em https://aistudio.google.com/apikey
# GOOGLE_API_KEY=AIza...

# Anthropic: chave em https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=sk-ant-...

# Modelo principal e fallbacks (opcionais). Se o principal falhar por cota, modelo
# inexistente ou erro do servidor, o agente tenta o próximo. Padrões:
#   groq      -> openai/gpt-oss-120b, openai/gpt-oss-20b, qwen/qwen3.8-27b
#   google    -> gemini-2.5-flash, gemini-2.5-flash-lite
#   anthropic -> claude-haiku-5-5
# EMPORIO_MODEL=openai/gpt-oss-120b
# EMPORIO_MODEL_FALLBACKS=openai/gpt-oss-20b,qwen/qwen3.8-27b

# Data "de hoje" para cálculo de prazos. Os pedidos do dataset vão até março/2026;
# fixar a data mantém os cenários de devolução/garantia coerentes. Remova para usar hoje.
EMPORIO_REFERENCE_DATE=2026-03-25
