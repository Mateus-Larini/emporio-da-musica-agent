# Provedor do modelo: "groq" (gratuito, sem cartão) ou "anthropic" (Claude).
# Se omitido, usa o provedor cuja chave estiver presente.
EMPORIO_PROVIDER=groq

# Groq: chave gratuita em https://console.groq.com/keys
GROQ_API_KEY=gsk_...

# Anthropic: chave em https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=sk-ant-...

# Modelo (opcional). Padrões: groq -> openai/gpt-oss-120b, anthropic -> claude-haiku-5-5
# EMPORIO_MODEL=claude-haiku-5-5

# Data "de hoje" para cálculo de prazos. Os pedidos do dataset vão até março/2026;
# fixar a data mantém os cenários de devolução/garantia coerentes. Remova para usar hoje.
EMPORIO_REFERENCE_DATE=2026-03-25
