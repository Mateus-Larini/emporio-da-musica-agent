# Chave da API da Anthropic (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=sk-ant-...

# Modelo usado pelo agente. Padrão: claude-haiku-5-5 (rápido e barato).
# Alternativas: claude-sonnet-5-5, claude-opus-5-5
EMPORIO_MODEL=claude-haiku-5-5

# Data "de hoje" para cálculo de prazos. Os pedidos do dataset vão até março/2026;
# fixar a data mantém os cenários de devolução/garantia coerentes. Remova para usar hoje.
EMPORIO_REFERENCE_DATE=2026-03-25
